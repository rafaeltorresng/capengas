{
  "name": "lance",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "node --disable-warning=ExperimentalWarning scripts/setup.ts",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "test:live": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --test --test-timeout=300000 test/live/*.test.ts",
    "smoke": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/smoke.ts",
    "turno": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/turno.ts",
    "evals": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/evals.ts",
    "demo:preparar": "node --disable-warning=ExperimentalWarning scripts/preparar-demo.ts",
    "agendador": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/agendador.ts",
    "errata:sintetica": "node --disable-warning=ExperimentalWarning scripts/errata-sintetica.ts",
    "typecheck": "tsc --noEmit",
    "build": "vite build web",
    "demo": "node src/server/main.ts amostra",
    "integrado": "node src/server/main.ts integrado",
    "catalogo:anvisa": "node --disable-warning=ExperimentalWarning scripts/catalogo-anvisa.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.0"
  }
}
